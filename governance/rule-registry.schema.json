{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztothez.github.io/design-engineering/schemas/rule-registry.schema.json",
  "title": "ZtotheZ Rule Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "compilerVersion", "authority", "generatedAt", "policy", "rules"],
  "properties": {
    "version": { "const": "1.0" },
    "compilerVersion": { "const": "1.0.0" },
    "authority": { "const": "SKILL.md" },
    "generatedAt": { "const": "deterministic-build" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedFromCurrentPublicBoundary",
        "projectPolicyIsNotExternalLaw",
        "privateSourcesAreNotRuntimeFallbacks"
      ],
      "properties": {
        "generatedFromCurrentPublicBoundary": { "const": true },
        "projectPolicyIsNotExternalLaw": { "const": true },
        "privateSourcesAreNotRuntimeFallbacks": { "const": true }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "category",
          "authorityClass",
          "evidenceClass",
          "rationale",
          "implementationLocations",
          "modelLinks",
          "sourceIds"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^ZTDE-[A-Z0-9-]+-[0-9]{3}$" },
          "owner": { "const": "ZtotheZ" },
          "category": { "type": "string", "minLength": 1, "maxLength": 120 },
          "authorityClass": {
            "enum": [
              "official-requirement",
              "measured-evidence",
              "heuristic",
              "product-specific",
              "project-policy"
            ]
          },
          "evidenceClass": {
            "enum": [
              "official-standard",
              "owner-authored",
              "owner-authorized-product-evidence",
              "synthetic-fixture",
              "automated-verification",
              "ai-assisted-expert-review",
              "human-expert-review",
              "representative-user-testing",
              "knowledge-gap"
            ]
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
          "implementationLocations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "modelLinks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      }
    }
  }
}
