{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztothez.com/schemas/knowledge-admission-v1.json",
  "title": "ZtotheZ Knowledge Admission Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "authority", "scope", "policy", "officialStandards", "records"],
  "properties": {
    "version": { "const": "1.0" },
    "authority": { "const": "SKILL.md" },
    "scope": { "const": "public-knowledge-base" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failClosedOnUnknownOrConflictingRecords",
        "aiAgentsCannotCompleteLegalReviewOrHumanAuthorization",
        "broadProjectLicenseDoesNotRelicenseThirdPartyInputs",
        "privateResearchIsNeverRuntimeFallback"
      ],
      "properties": {
        "failClosedOnUnknownOrConflictingRecords": { "const": true },
        "aiAgentsCannotCompleteLegalReviewOrHumanAuthorization": { "const": true },
        "broadProjectLicenseDoesNotRelicenseThirdPartyInputs": { "const": true },
        "privateResearchIsNeverRuntimeFallback": { "const": true }
      }
    },
    "officialStandards": {
      "type": "array",
      "items": { "$ref": "#/$defs/officialStandard" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "officialStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authorityName", "canonicalUrl", "status", "verifiedAt", "reuseTerms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "authorityName": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "pattern": "^https://.+" },
        "status": { "type": "string", "minLength": 1 },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "reuseTerms": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "contentDigest",
        "sourceIdentity",
        "licensing",
        "transformation",
        "decisions",
        "review"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ztde-kb-[a-f0-9]{16}$" },
        "path": { "type": "string", "pattern": "^knowledge-base/[A-Za-z0-9._/-]+$" },
        "contentDigest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceRecord",
            "sourceOrigin",
            "declaredOwner",
            "evidence",
            "authorizationBoundary",
            "officialStandards"
          ],
          "properties": {
            "sourceRecord": { "type": "string", "minLength": 1 },
            "sourceOrigin": { "enum": ["original", "user-owned"] },
            "declaredOwner": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "location"],
              "properties": {
                "kind": { "enum": ["public-source-summary", "repository-history"] },
                "location": { "type": "string", "minLength": 1 }
              }
            },
            "authorizationBoundary": { "type": "string", "minLength": 1 },
            "officialStandards": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
            }
          }
        },
        "licensing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["licenseOrPermissionBasis", "reuseBasis", "broadProjectLicenseRelicense"],
          "properties": {
            "licenseOrPermissionBasis": { "type": "string", "minLength": 1 },
            "reuseBasis": { "type": "string", "minLength": 1 },
            "broadProjectLicenseRelicense": { "const": false }
          }
        },
        "transformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method"],
          "properties": {
            "status": {
              "enum": ["independently-authored", "owner-evidence-normalized", "synthetic-benchmark"]
            },
            "method": { "type": "string", "minLength": 1 }
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicDistribution", "package", "retrieval", "disposition"],
          "properties": {
            "publicDistribution": { "const": "approved" },
            "package": { "const": "approved" },
            "retrieval": { "enum": ["included", "excluded"] },
            "disposition": { "const": "admit" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewedBy",
            "reviewerRole",
            "reviewedAt",
            "legalReviewStatus",
            "humanAuthorizationStatus",
            "aiAgentCanComplete"
          ],
          "properties": {
            "reviewedBy": { "type": "string", "minLength": 1 },
            "reviewerRole": { "enum": ["owner-maintainer", "human-maintainer"] },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "legalReviewStatus": { "const": "not-a-legal-opinion-owner-reviewed" },
            "humanAuthorizationStatus": {
              "enum": ["not-applicable-project-authored", "owner-authorized"]
            },
            "aiAgentCanComplete": { "const": false }
          }
        }
      }
    }
  }
}
