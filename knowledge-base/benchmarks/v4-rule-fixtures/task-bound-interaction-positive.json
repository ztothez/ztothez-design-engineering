{
  "version": "1.1",
  "contract": "task-bound-interaction-positive",
  "profiles": [{
    "id": "qualified-interaction",
    "name": "Qualified interaction",
    "environment": ["Deterministic repository fixture"],
    "journeys": [{
      "id": "recover-task",
      "name": "recover-task",
      "interaction": { "task": "complete-task", "phases": ["primary", "recovery"] },
      "steps": [
        { "action": "expectVisible", "selector": "main" },
        { "action": "checkpoint", "checkpoint": "start" },
        { "action": "expectVisible", "selector": "[role=alert]" },
        { "action": "checkpoint", "checkpoint": "failure" },
        { "action": "expectVisible", "selector": "[data-preserved=true]" },
        { "action": "checkpoint", "checkpoint": "preserved-state" },
        { "action": "expectVisible", "selector": "[data-status=complete]" },
        { "action": "checkpoint", "checkpoint": "success" }
      ]
    }]
  }]
}
