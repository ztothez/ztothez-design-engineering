{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztothez.com/schemas/design-engineering-model-v1.json",
  "title": "ZtotheZ Design Engineering Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "product",
    "authority",
    "lifecycle",
    "cutoverStatus",
    "policy",
    "sourceRegistry",
    "entities",
    "relationships",
    "conflicts",
    "decisionTraces"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "product": { "const": "ZtotheZ Design Engineering" },
    "authority": { "const": "SKILL.md" },
    "lifecycle": { "const": "shadow" },
    "cutoverStatus": { "const": "not-authoritative-until-v5-item-8" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdownRemainsWorkflowAuthorityDuringMigration",
        "privateSourcesAreRuntimeFallbacks",
        "unsupportedRequestsProduceKnowledgeGap",
        "documentOrderCannotResolveContradictions"
      ],
      "properties": {
        "markdownRemainsWorkflowAuthorityDuringMigration": { "const": true },
        "privateSourcesAreRuntimeFallbacks": { "const": false },
        "unsupportedRequestsProduceKnowledgeGap": { "const": true },
        "documentOrderCannotResolveContradictions": { "const": true }
      }
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissionManifest", "officialStandards", "projectPolicySources"],
      "properties": {
        "admissionManifest": { "const": "governance/knowledge-admission.json" },
        "officialStandards": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
        },
        "projectPolicySources": {
          "type": "array",
          "minItems": 1,
          "items": { "const": "ztothez-design-engineering-policy" }
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conflict" }
    },
    "decisionTraces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionTrace" }
    }
  },
  "$defs": {
    "authorityClass": {
      "enum": [
        "official-requirement",
        "measured-evidence",
        "heuristic",
        "product-specific",
        "project-policy"
      ]
    },
    "evidenceClass": {
      "enum": [
        "official-standard",
        "owner-authored",
        "owner-authorized-product-evidence",
        "synthetic-fixture",
        "automated-verification",
        "ai-assisted-expert-review",
        "human-expert-review",
        "representative-user-testing",
        "knowledge-gap"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "name",
        "lifecycle",
        "owner",
        "authorityClass",
        "evidenceClass",
        "scope",
        "rationale",
        "sourceRefs",
        "metrics",
        "verificationRefs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" },
        "category": {
          "enum": [
            "product-archetype",
            "user-task",
            "state-recovery-contract",
            "quality-attribute",
            "design-token",
            "component-responsibility",
            "information-priority",
            "interaction-pattern",
            "visual-composition",
            "accessibility-constraint",
            "evidence-class",
            "verification-method",
            "conflict-policy",
            "exception-policy",
            "abstention-policy"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "shadow", "active", "deprecated"] },
        "owner": { "const": "ZtotheZ" },
        "authorityClass": { "$ref": "#/$defs/authorityClass" },
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "scope": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "value", "authorityClass"],
            "properties": {
              "id": { "type": "string", "pattern": "^ztde-[a-z0-9-]+$" },
              "kind": { "enum": ["threshold", "coverage", "traceability", "state", "qualitative"] },
              "value": { "type": "string", "minLength": 1 },
              "authorityClass": { "$ref": "#/$defs/authorityClass" }
            }
          }
        },
        "verificationRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ZTDE-MODEL-VERIFY-[0-9]{3}$" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "from", "to", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^ZTDE-MODEL-REL-[0-9]{3}$" },
        "type": {
          "enum": [
            "activates",
            "answers",
            "constrains",
            "implemented-by",
            "verified-by",
            "evidenced-by",
            "overrides",
            "requires",
            "allows-exception",
            "abstains-when"
          ]
        },
        "from": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" },
        "to": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "higherPriorityEntity", "lowerPriorityEntity", "resolution", "evidenceRequired"],
      "properties": {
        "id": { "type": "string", "pattern": "^ZTDE-MODEL-CONFLICT-[0-9]{3}$" },
        "when": { "type": "string", "minLength": 1 },
        "higherPriorityEntity": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" },
        "lowerPriorityEntity": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" },
        "resolution": { "type": "string", "minLength": 1 },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceClass" }
        }
      }
    },
    "decisionTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "taskRef", "orderedEntityRefs", "requiredVerificationRefs", "expectedEvidenceClasses"],
      "properties": {
        "id": { "type": "string", "pattern": "^ZTDE-MODEL-TRACE-[0-9]{3}$" },
        "taskRef": { "type": "string", "pattern": "^ZTDE-MODEL-TASK-[0-9]{3}$" },
        "orderedEntityRefs": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "pattern": "^ZTDE-MODEL-[A-Z0-9]+-[0-9]{3}$" }
        },
        "requiredVerificationRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^ZTDE-MODEL-VERIFY-[0-9]{3}$" }
        },
        "expectedEvidenceClasses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceClass" }
        }
      }
    }
  }
}
