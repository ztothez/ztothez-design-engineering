{
  "name": "@ztothez/design-engineering",
  "version": "2.0.3",
  "description": "ZtotheZ Design Engineering System: MCP-backed product design architecture, knowledge, verification, and quality gates.",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/server.d.ts",
      "import": "./dist/src/server.js"
    }
  },
  "files": [
    "dist/",
    "docs/installation.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "SKILL.md",
    "V2-ROADMAP.md",
    "V3-ROADMAP.md",
    "V4-ROADMAP.md",
    "knowledge-base/INDEX.md",
    "knowledge-base/retrieval-scope.yaml",
    "knowledge-base/maintained/",
    "knowledge-base/design-intelligence/",
    "knowledge-base/benchmarks/aegisops/",
    "knowledge-base/benchmarks/scenestart/",
    "knowledge-base/benchmarks/corpus/",
    "knowledge-base/benchmarks/interface-quality/",
    "knowledge-base/benchmarks/azure-optimizer/",
    "knowledge-base/benchmarks/delivery-pilots.yaml",
    "knowledge-base/benchmarks/v4-evaluation.yaml",
    "knowledge-base/benchmarks/v4-rule-fixtures/",
    "knowledge-base/benchmarks/portfolio-corpus/",
    "knowledge-base/usability-evaluation/HEURISTIC_EVALUATION.md",
    "knowledge-base/usability-evaluation/heuristic-review.schema.yaml",
    "knowledge-base/usability-evaluation/heuristic-review.template.yaml",
    "knowledge-base/provenance.yaml",
    "knowledge-base/dependencies.yaml"
  ],
  "bin": {
    "ztothez-design": "dist/cli/index.js",
    "zz-design": "dist/cli/index.js"
  },
  "scripts": {
    "audit": "tsx cli/audit.ts",
    "assess-maintainer": "npm run build --silent && node dist/cli/assess-maintainer-review.js",
    "capture-comparison-engineering": "npm run build --silent && node scripts/capture-comparison-engineering.mjs",
    "compile-comparison": "npm run build --silent && node dist/cli/compile-comparison-review.js",
    "compile-plan": "npm run build --silent && node dist/cli/compile-plan.js",
    "generate-react": "npm run build --silent && node dist/cli/generate-react.js",
    "repair-react": "npm run build --silent && node dist/cli/repair-react.js",
    "qualify-pilots": "npm run build --silent && node dist/cli/qualify-pilots.js",
    "evaluate-v4": "npm run build --silent && node dist/cli/evaluate-v4.js",
    "qualify-v4": "npm run build --silent && node dist/cli/qualify-v4.js",
    "generate-comparison-packet": "node scripts/generate-comparison-review-packet.mjs",
    "aggregate-gates": "npm run build --silent && node dist/cli/aggregate-gates.js",
    "build": "tsc",
    "evaluate-corpus": "npm run build --silent && node dist/cli/evaluate-corpus.js",
    "package:check": "npm run build --silent && node scripts/package-check.mjs",
    "package:smoke": "npm run build --silent && node scripts/package-smoke.mjs",
    "portfolio": "npm run build --silent && node dist/cli/index.js portfolio",
    "prepack": "npm run build",
    "quality-gate": "npm run build --silent && node dist/cli/quality-gate.js",
    "independence:check": "node scripts/validate-independence.mjs",
    "independence:archive-smoke": "node scripts/archive-removal-smoke.mjs",
    "release:pack": "npm run build --silent && node scripts/create-release.mjs",
    "release:check": "node scripts/verify-offline-release.mjs",
    "release:verify": "npm run release:pack && npm run release:check",
    "review-heuristics": "npm run build --silent && node dist/cli/review-heuristics.js",
    "start": "node dist/cli/index.js",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "validate-contract": "npm run build --silent && node dist/cli/validate-contract.js",
    "validate-comparison": "npm run build --silent && node dist/cli/validate-comparison.js",
    "validate-brief": "npm run build --silent && node dist/cli/validate-brief.js",
    "validate-design": "npm run build --silent && node dist/cli/validate-design.js",
    "validate-information": "npm run build --silent && node dist/cli/validate-information.js",
    "validate-trust": "npm run build --silent && node dist/cli/validate-trust.js",
    "verify-ui": "npm run build --silent && node dist/cli/verify-ui.js",
    "v3:evidence": "node scripts/capture-v3-evidence.mjs",
    "v4:qualification": "node scripts/capture-v4-qualification.mjs"
  },
  "keywords": [
    "design-engineering",
    "mcp",
    "product-design",
    "quality-gate",
    "ui",
    "ux"
  ],
  "author": "ZtotheZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztothez/ztothez-design-engineering.git"
  },
  "homepage": "https://github.com/ztothez/ztothez-design-engineering#readme",
  "bugs": {
    "url": "https://github.com/ztothez/ztothez-design-engineering/issues"
  },
  "funding": "https://buymeacoffee.com/ztothez",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "GPL-3.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12"
  }
}
